# Среда выполнения: development, production, test
APP_ENV=development

# Порт HTTP-сервера
HTTP_PORT=8080

# Таймаут обработки входящих запросов
HTTP_TIMEOUT=15s

# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spa_inventory?sslmode=disable

# Параметры пула соединений PostgreSQL (pgxpool)
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=30m
DB_POOL_HEALTH_CHECK_PERIOD=1m
